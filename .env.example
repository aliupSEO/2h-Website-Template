# Copy to .env.local and fill real values. Never commit .env.local.
# Server / BFF only — do not prefix secrets with VITE_

# Hub database (Supabase) — service role must stay server-side
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# GitHub (BFF)
GITHUB_TOKEN=
GITHUB_ORG=

# Vercel (BFF)
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# Firebase Admin (BFF) — prefer path to SA JSON, not inline JSON in env
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Public client config only (safe for browser if RLS/rules are correct)
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
