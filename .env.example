# Copy to .env.local and fill real values. Never commit .env.local.
# https://supabase.com/dashboard/project/_/settings/api

# --- Supabase (browser / Vite) ---
# Project URL + anon (public) key. Safe in the client only with RLS enabled.
# Auth redirects use window.location.origin — allowlist them in Supabase Auth URL config.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Supabase (server / BFF / CLI) ---
# Same project URL + keys for local tooling and future backend. Never use VITE_ for service role.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: project ref for linking CLI (`supabase link`)
# SUPABASE_PROJECT_ID=

# GitHub (BFF — server only, never VITE_*)
# Fine-grained PAT: repo read/write on target account or org
GITHUB_TOKEN=
# Optional: list/create under this org (omit for authenticated user repos)
GITHUB_ORG=

# Vercel (BFF — server only, never VITE_*)
# Access token from Vercel → Settings → Tokens
VERCEL_TOKEN=
# Team id when using team-scoped projects (Settings → General)
VERCEL_TEAM_ID=
# Webhook signing secret shown when creating the Hub webhook in Vercel
VERCEL_WEBHOOK_SECRET=

# Firebase Admin (BFF) — prefer path to SA JSON, not inline JSON in env
# See docs/firebase-api/credentials-runbook.md
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
# Alternative for Vercel / hosts without a file path (server only, never VITE_*)
# FIREBASE_SERVICE_ACCOUNT_JSON=

# SMTP (BFF — server only, never VITE_*)
# Used for user invitations and password reset emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=2H Central Hub <noreply@example.com>
# true for port 465, otherwise STARTTLS on 587
SMTP_SECURE=false

# Public app URL for auth/invite links (no trailing slash)
APP_URL=http://localhost:5173
