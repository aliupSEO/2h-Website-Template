# =============================================================================
# Environment Variables — copy to .env.local and fill in values
# =============================================================================

# -----------------------------------------------------------------------------
# WordPress (REQUIRED)
# -----------------------------------------------------------------------------

# Your WordPress WPGraphQL endpoint URL
# Plugin required: https://wordpress.org/plugins/wp-graphql/
NEXT_PUBLIC_WORDPRESS_GRAPHQL_URL=https://your-wordpress-site.com/graphql

# Your WordPress base URL (used for REST API calls — contact form, form settings)
# No trailing slash.
NEXT_PUBLIC_WORDPRESS_REST_URL=https://your-wordpress-site.com

# -----------------------------------------------------------------------------
# Firebase (OPTIONAL — contact form Firestore fallback)
# Only needed if you want submissions saved to Firebase when WordPress is down.
# Plugin required on WP side: firebase-form custom plugin
# -----------------------------------------------------------------------------

FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_API_KEY=your-firebase-api-key

# Firestore collection name for form submissions (default: "submissions")
FIREBASE_COLLECTION=