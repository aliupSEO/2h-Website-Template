# Copy to .env.local and fill real values. Never commit .env.local.
# https://supabase.com/dashboard/project/_/settings/api

# --- Supabase (browser / Vite) ---
# Project URL + anon (public) key. Safe in the client only with RLS enabled.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Supabase (server / BFF / CLI) ---
# Same project URL + keys for local tooling and future backend. Never use VITE_ for service role.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: project ref for linking CLI (`supabase link`)
# SUPABASE_PROJECT_ID=

# GitHub (BFF)
GITHUB_TOKEN=
GITHUB_ORG=

# Vercel (BFF)
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# Firebase Admin (BFF) — prefer path to SA JSON, not inline JSON in env
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
